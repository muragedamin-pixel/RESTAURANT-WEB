# ── Existing ─────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_ORIGIN=http://localhost:5500
JWT_SECRET=change_me_in_production

# ── Square POS ────────────────────────────────────────────────────────────────
# Get these from https://developer.squareup.com/apps
SQUARE_ENVIRONMENT=sandbox           # "sandbox" | "production"
SQUARE_ACCESS_TOKEN=your_square_sandbox_access_token
SQUARE_LOCATION_ID=your_square_location_id

# ── Toast POS ─────────────────────────────────────────────────────────────────
# Get these from https://dev.toasttab.com  (Developer Portal)
TOAST_ENVIRONMENT=sandbox            # "sandbox" | "production"
TOAST_CLIENT_ID=your_toast_client_id
TOAST_CLIENT_SECRET=your_toast_client_secret
TOAST_RESTAURANT_GUID=your_restaurant_guid

# ── SumUp POS ─────────────────────────────────────────────────────────────────
# Create an API key at https://me.sumup.com/settings/developer
SUMUP_API_KEY=sup_sk_your_sumup_api_key

# ── M-Pesa Daraja ─────────────────────────────────────────────────────────────
# Get credentials from https://developer.safaricom.co.ke
MPESA_ENVIRONMENT=sandbox            # "sandbox" | "production"
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379               # sandbox default; use your actual Paybill/Till in production
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919  # sandbox default
MPESA_CALLBACK_URL=https://your-api.railway.app/api/mpesa/callback
